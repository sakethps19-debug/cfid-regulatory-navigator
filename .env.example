# CFID Regulatory Navigator — environment variables
#
# Copy this file to .env.local for local development, or set these as
# environment variables in your hosting provider (e.g. Vercel Project
# Settings → Environment Variables). Never commit real values.

# Username for the single authorised pilot user.
PILOT_USERNAME=

# Password for the single authorised pilot user. Use a strong, unique value.
PILOT_PASSWORD=

# Random secret (at least 32 characters recommended) used to sign session
# cookies. Generate one with, e.g.: openssl rand -base64 32
AUTH_SECRET=

# --- Supabase (Postgres backend) ---
# Project URL, e.g. https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key — safe for browser code. RLS policies restrict
# every table to allow-listed authenticated users only; there is no
# anonymous read/write access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER-SIDE / SCRIPTS ONLY. Never expose this to the
# browser or commit it. Used only by scripts/db/run-import.ts and other
# server-only maintenance scripts that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of email addresses allowed to sign in (case
# insensitive). Checked server-side against Supabase Auth and mirrored
# into the app_allowed_emails table used by the is_allowed_user() RLS
# policy function.
ALLOWED_EMAILS=

# Set to "true" to enable logging of scenario-analyzer queries into the
# query_runs table (disabled by default for user privacy).
ENABLE_QUERY_LOGGING=false
